{
  "expo": {
    "name": "0bol",
    "slug": "tin-cup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "obol",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08090B",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08090B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.obol.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "0bol uses the camera so you can go live and capture profile photos.",
        "NSPhotoLibraryUsageDescription": "0bol needs photo library access to choose profile images.",
        "NSPhotoLibraryAddUsageDescription": "0bol may save photos you capture to your library.",
        "NSMicrophoneUsageDescription": "0bol uses the microphone when you go live or record video."
      }
    },
    "android": {
      "package": "com.obol.app",
      "adaptiveIcon": {
        "backgroundColor": "#08090B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-camera",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "color": "#FFB43D"
        }
      ],
      "expo-splash-screen",
      "expo-updates",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://wmeavdmmymawotzxxtuj.supabase.co",
      "supabaseAnonKey": "",
      "router": {},
      "eas": {
        "projectId": "8f127ab8-eec3-4110-8492-b1ce0cb7739c"
      }
    },
    "owner": "djoek47",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8f127ab8-eec3-4110-8492-b1ce0cb7739c"
    }
  }
}
