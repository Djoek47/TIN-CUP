# Money rail: mock (default) | stripe | thirdweb
EXPO_PUBLIC_MONEY_MODE=mock

# Reference gold spot (per troy ounce). Optional — defaults used if unset.
EXPO_PUBLIC_XAU_USD=2650
EXPO_PUBLIC_XAU_CAD=3520

# Thirdweb (crypto rail — minimal wallet KYC)
EXPO_PUBLIC_THIRDWEB_CLIENT_ID=your_client_id_here
EXPO_PUBLIC_THIRDWEB_CHAIN=base-sepolia
EXPO_PUBLIC_USDT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
EXPO_PUBLIC_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
EXPO_PUBLIC_PROJECT_WALLET=0x0000000000000000000000000000000000000000

# Stripe (fiat rail — Connect KYC for bank cash-out)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# Server-side secrets stay off-device (Supabase edge / backend)

# LiveKit (optional — camera fallback if unset)
EXPO_PUBLIC_LIVEKIT_URL=
EXPO_PUBLIC_LIVEKIT_TOKEN_URL=

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
