# Money rail: mock | stripe | thirdweb | auto (picks stripe → thirdweb → mock)
EXPO_PUBLIC_MONEY_MODE=auto

# Demo seats (Vagrant/Lord). Auto-on in __DEV__; set 1 for TestFlight QA builds.
EXPO_PUBLIC_ALLOW_DEMO_AUTH=1

# Reference gold spot (per troy ounce). Optional — defaults used if unset.
EXPO_PUBLIC_XAU_USD=2650
EXPO_PUBLIC_XAU_CAD=3520

# Thirdweb (optional — off critical path for MVP)
EXPO_PUBLIC_THIRDWEB_CLIENT_ID=your_client_id_here
EXPO_PUBLIC_THIRDWEB_CHAIN=base-sepolia
EXPO_PUBLIC_USDT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
EXPO_PUBLIC_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
EXPO_PUBLIC_PROJECT_WALLET=0x0000000000000000000000000000000000000000

# Stripe (fiat rail — Connect KYC for bank cash-out)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# Server-side (Supabase Edge secrets): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET

# LiveKit (remote live video)
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# Server-side secrets: LIVEKIT_API_KEY, LIVEKIT_API_SECRET, LIVEKIT_URL

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
