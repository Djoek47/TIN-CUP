{
  "name": "tin-cup",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --tunnel",
    "dev:lan": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "eas build -p ios --profile production",
    "submit:ios": "eas submit -p ios --profile production",
    "eas:whoami": "bash scripts/eas-with-token.sh whoami",
    "eas:build:ios": "bash scripts/eas-with-token.sh build",
    "eas:submit:ios": "bash scripts/eas-with-token.sh submit",
    "update:preview": "eas update --branch preview --environment preview --message \"Vessel OTA preview\" --non-interactive",
    "update:prod": "eas update --branch production --environment production --message \"Vessel OTA\" --non-interactive"
  },
